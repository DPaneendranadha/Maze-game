        prev=keys[pygame.K_ESCAPE]
        if (pygame.sprite.collide_rect(temp,final_point) or Life_left==0 or remaining_time<=0 or keys[pygame.K_RETURN]) and not previ:
             screen_var=5
             player.rect.x=0
