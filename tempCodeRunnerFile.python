             if Life_left==0 or remaining_time<0:
                message=1
             else :message=0
                  
             coins=[]
             Timeleft=remaining_time//1000
             if 0<Timeleft<10:
                Timeleft="0"+str(Timeleft)
             elif Timeleft<0:
                Timeleft="00"
             else:
                Timeleft=str(Timeleft)
            
            
        previ=keys[pygame.K_ESCAPE]
        pygame.display.flip()
    elif screen_var==5:
        
         pygame.font.init()
         main=pygame.font.Font(None, 70)
         if message==0:
           result=main.render("You have found the one piece", True, (255, 255, 255))
         else:
          result=main.render("You failed.Better luck next time", True, (255, 255, 255))
         result_rect=result.get_rect()
