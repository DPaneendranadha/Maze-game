    ########## If the final point is the bottom corner #############
          # draw(points[-1][0],points[-1][1],wp-dim,hp-dim,dim,trail)
    ########### If the final point is random ########################################
           nbg_points=[]
           x=[trail[-1][0],trail[-1][1]] # x is final_point
           for i in [-1,0,1]:
                for j in [-1,0,1]:
                     nbg_points.append([x[0]+i*dim,x[1]+j*dim])
           trail.insert(0,[0,0])
           solution=trail_convert(trail)
           print(trail)
           print(solution)
           file_path="solution.txt"
           with open(file_path, "w") as file:
              for i in solution:
                 file.write(i)
           file.close()
           trail.sort()
           start_time=pygame.time.get_ticks()
           end_time=start_time+10000 
           for x in range(0,wp,dim):
             for y in range(0,hp,dim):       
               if random.random() <rand and [x,y] not in trail and [x,y] not in nbg_points:
                   maze.append([x,y])
           for x in range(0,wp,dim):
              for y in range(0,hp,dim):       
                  if [x,y] not in maze and [x,y] not in trail :
                      other_points.append([x,y])
           for x in range(0,wp,dim):
               for y in range(0,hp,dim):       
                     if [x,y] not in maze  :
                             way_points.append([x,y])
      ######### Finish of the maze ##############
      ########## Sprites #############
           i=0
           while i < 20:
              a = random.choice(range(len(other_points)))
              if [other_points[a][0],other_points[a][1]] not in coins:
                 coins.append([other_points[a][0],other_points[a][1]])
                 i+=1
           i=0
           while i < 20:
              a = random.choice(range(len(trail)))
              if [trail[a][0],trail[a][1]] not in coins:
                 coins.append([trail[a][0],trail[a][1]])
                 i+=1
           i=0
           while i < 5:
              a = random.choice(range(len(trail)))
              if [trail[a][0],trail[a][1]] not in coins:
                 timec.append([trail[a][0],trail[a][1]])
                 i+=1
           i=0
           while i < 10:
              a = random.choice(range(len(other_points)))
              if [other_points[a][0],other_points[a][1]] not in coins:
                 timec.append([other_points[a][0],other_points[a][1]])
                 i+=1
            
           i=0
           while i < 40:
              a = random.choice(range(len(maze)))
              if [maze[a][0],maze[a][1]] not in wrong_walls:
                 wrong_walls.append([maze[a][0],maze[a][1]])
                 i+=1
           i=0
           while i<no_of_enemies:
              a = random.choice(range(len(trail)))
              if [trail[a][0],trail[a][1]] not in coins and trail[a][0]>200 and trail[a][1]>200:
                 enemy.append([trail[a][0],trail[a][1]])
                 e=animate(trail[a][0],trail[a][1],dim,dim,img_arr2)
                 all_enemies.add(e)
                 i+=1
           i=0
           while i<loot:
                a = random.choice(range(len(other_points)))
                if [other_points[a][0],other_points[a][1]] not in (coins or timec):
                  powers.append([other_points[a][0],other_points[a][1]])
                  i+=1
           for [x,y] in maze:
              if [x,y+dim] not in maze:
                 wall=Wall(x,y,dim,dim,"b3.jpg")
                 all_walls.add(wall)
              else :
                 wall=Wall(x,y,dim,dim,"b3.jpg")
                 all_walls.add(wall)
           for w in all_walls:
              if w  in all_wrongwalls:
                 all_walls.remove(w)
                 
           print(trail[-1][0],trail[-1][1])
           final_point=Wall(trail[-1][0],trail[-1][1],dim,dim,"island1.png")
           for x in coins:
             money=Wall(x[0],x[1],dim,dim,"gold.png")
