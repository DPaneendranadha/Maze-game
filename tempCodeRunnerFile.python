           all_elements.add(all_time)
           newsprite.add(all_walls)
           newsprite.add(all_wrongwalls)
           newsprite.remove(player)     
           newsprite.remove(all_gold)   
           traps.add(all_enemies)
           traps.add(all_wrongwalls) 
           

        v = 1
###############       END OF MAZE GENERATION   ##################
        maze_surface.fill((49,113,200))
        for wall in all_elements:
                wall.dra(maze_surface)
        player.dra(maze_surface)
        for w in all_waves:
           w.dra(maze_surface)
            
################# To move the maze along with  ################
        screen.blit(maze_surface,(50,40),display)
        a=player.rect.x
        b=player.rect.y
        if a>400 and a <=1200:
           display.x=a-400
        elif a<=450:
           display.x=0
        else:
           display.x=800
        if b>400 and b<=1200:
           display.y=b-400
        elif b<=400:
           display.y=0
        else:
           display.y=800         
################ PLAYER UPDATE #########################
        keys = pygame.key.get_pressed()
        if keys[pygame.K_UP] :
             temp=Wall(a,b-dim,80,80,"try.png")    
             direction=1   
             give=1
        elif keys[pygame.K_DOWN] :
             temp=Wall(a,b+dim,80,80,"try.png")
             direction=3   
             give=1
        elif keys[pygame.K_RIGHT]  :
             temp=Wall(a+dim,b,80,80,"try.png")
             direction=0
             give=1
        elif keys[pygame.K_LEFT] :
             temp=Wall(a-dim,b,80,80,"try.png")
             direction=2
             give=1
        else :
           temp=copy.copy(player)
           give=0
           direction=0

################# Collision Detection ################
        if temp.rect.x>=0 and temp.rect.x<=1520 and temp.rect.y>=0 and temp.rect.y<=1520:
         if not pygame.sprite.spritecollideany(temp,all_elements):
           player.update(temp.rect.x,temp.rect.y,direction,give)
         elif pygame.sprite.spritecollideany(temp,traps):
           Life_left-=1
           
           image("explosion.png",maze_surface,dim,dim,player.rect.x,player.rect.y)
           screen.blit(maze_surface,(50,40),display)
           pygame.display.flip()
           pygame.time.delay(1000)
           player.update(0,0,0,1)  # updates the player to the starting position.
           print("collided")
         elif pygame.sprite.spritecollideany(temp,all_walls):
            sound_effect1.play()

         elif pygame.sprite.spritecollideany(temp,all_gold):
           player.update(temp.rect.x,temp.rect.y,direction,give)
           for c in all_gold:
              if pygame.sprite.collide_rect(player,c):
                 c.kill()
           score+=10 
         elif pygame.sprite.spritecollideany(temp,all_time):
           player.update(temp.rect.x,temp.rect.y,direction,give)
           for c in all_time:
              if pygame.sprite.collide_rect(player,c):
                 c.kill()
           leveltime+=1000 
         elif pygame.sprite.spritecollideany(temp,power_sprite):
           player.update(temp.rect.x,temp.rect.y,direction,give)
           for c in power_sprite:
              if pygame.sprite.collide_rect(player,c):
                 c.kill()
           no_of_powers+=1
         else:
            player.update(temp.rect.x,temp.rect.y,direction,give)
#################### Powers usage #########################
        keys=pygame.key.get_pressed()
        if no_of_powers>0:
         if keys[pygame.K_SPACE] and keys[pygame.K_UP] and not prev1:
           wave=animate(player.rect.x,player.rect.y,dim,dim,power)
          
           wave.store(1)
           all_waves.add(wave)
           no_of_powers-=1
         prev1=keys[pygame.K_UP]
         if keys[pygame.K_SPACE] and keys[pygame.K_RIGHT] and not prev2 :
           wave=animate(player.rect.x,player.rect.y,dim,dim,power)
           wave.store(0)
           all_waves.add(wave)
           no_of_powers-=1
         prev2=keys[pygame.K_RIGHT]
         if keys[pygame.K_SPACE] and keys[pygame.K_LEFT] and not prev3:
           wave=animate(player.rect.x,player.rect.y,dim,dim,power)
           wave.store(2)
           all_waves.add(wave)
           no_of_powers-=1
         prev3=keys[pygame.K_LEFT]
         if keys[pygame.K_SPACE] and keys[pygame.K_DOWN] and not prev4:
           wave=animate(player.rect.x,player.rect.y,dim,dim,power)
           wave.store(3)
           all_waves.add(wave)
           no_of_powers-=1
         prev4=keys[pygame.K_DOWN]
        for w in all_waves:
            w.wave_update() 
            for e in all_enemies:
               if pygame.sprite.collide_rect(w,e):
                  w.kill()
                  score+=10
                  
                  kill+=1
                  image("explosion.png",maze_surface,dim,dim,e.rect.x,e.rect.y)
                  screen.blit(maze_surface,(50,40),display)
                  pygame.display.flip()
                  e.kill()
            if pygame.sprite.spritecollideany(w,all_walls):
               w.kill()

        pygame.font.init()
        font = pygame.font.Font(None, 36)
        screen.fill((0, 0, 0), (700, 10, 200, 50))
        current_time = pygame.time.get_ticks()
        remaining_time = leveltime - (current_time - start_time)
        current_time = pygame.time.get_ticks()
        remaining_time = leveltime - (current_time - start_time)
        text = font.render("Time: " + str(remaining_time / 1000), True, (255, 255, 255))
        screen.blit(text, (700, 10))
        pygame.font.quit()
        pygame.font.init()
        screen.fill((0, 0, 0), (10, 10, 150, 50))
        screen.fill((0, 0, 0), (500, 10, 200, 50))
        screen.fill((0,0,0),  ( 200,10,200,50))
       
        
######################## DISPLAY / STATUS BAR ############################
        font = pygame.font.Font(None, 36)
        text = font.render("Score: " + str(score), True, (255, 255, 255))
        screen.blit(text, (10, 10))
        text = font.render("LIFE LEFTS: " + str(Life_left), True, (255, 255, 255))
        screen.blit(text, (500, 10))
        text = font.render("Power:"+ str(no_of_powers),True,(255,255,255))
        screen.blit(text,(200,10))    
########### ENEMY UPDATE #######################
        for sprite in all_enemies:
           sprite.enemy_update(20,newsprite)
#################################################
        pygame.font.quit()
        if keys[pygame.K_ESCAPE] and not prev :
            screen_var=0
            v=0
            player.rect.x=0
