             player.rect.x=0
             player.rect.y=0
             v=0
             maze=[]
             points=[]
             trail=[]
             enemy=[]
             display.x=0
             display.y=0
             all_elements.empty()
             all_gold.empty()
             all_walls.empty()
             all_wrongwalls.empty()
             traps.empty()
             all_enemies.empty()
             newsprite.empty()
            elif exit2_rect.collidepoint(event.pos):
             
             running=False       
    clock.tick(10)
pygame.quit()
sys.exit()










